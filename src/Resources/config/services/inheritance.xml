<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Scythe\SnippetSetInheritance\Config\PluginConfig">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="Scythe\SnippetSetInheritance\Inheritance\SnippetInheritanceResolver">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Scythe\SnippetSetInheritance\Config\PluginConfig"/>
        </service>

        <service id="Scythe\SnippetSetInheritance\Inheritance\SnippetInheritanceMerger">
            <argument type="service" id="Scythe\SnippetSetInheritance\Inheritance\SnippetInheritanceResolver"/>
        </service>
    </services>
</container>
